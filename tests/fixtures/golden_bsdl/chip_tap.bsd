-- BSDL for the IEEE 1149.1 TAP inserted by warptap (TAP only; no boundary register).
-- Read the DESIGN_WARNING attribute below before using this file with a boundary-scan tool.

entity chip is

  generic (PHYSICAL_PIN_MAP : string := "UNPACKAGED");

  port (
    tck    : in bit;
    tms    : in bit;
    tdi    : in bit;
    trst_n : in bit;
    tdo    : out bit
  );

  use STD_1149_1_2001.all;

  attribute COMPONENT_CONFORMANCE of chip : entity is "STD_1149_1_2001";

  attribute PIN_MAP of chip : entity is PHYSICAL_PIN_MAP;

  constant UNPACKAGED : PIN_MAP_STRING :=
    "tck    : tck," &
    "tms    : tms," &
    "tdi    : tdi," &
    "trst_n : trst_n," &
    "tdo    : tdo";

  attribute TAP_SCAN_IN    of tdi    : signal is true;
  attribute TAP_SCAN_MODE  of tms    : signal is true;
  attribute TAP_SCAN_OUT   of tdo    : signal is true;
  attribute TAP_SCAN_CLOCK of tck    : signal is (1.000000e+07, BOTH);
  attribute TAP_SCAN_RESET of trst_n : signal is true;

  attribute INSTRUCTION_LENGTH of chip : entity is 4;

  attribute INSTRUCTION_OPCODE of chip : entity is
    "EXTEST  (0000)," &
    "SAMPLE  (0010)," &
    "PRELOAD (0010)," &
    "IDCODE  (0001)," &
    "BYPASS  (1111)";

  attribute INSTRUCTION_CAPTURE of chip : entity is "0001";

  attribute IDCODE_REGISTER of chip : entity is
    "0001" &                  -- version
    "1010010110100101" &      -- part number
    "00000000001" &           -- manufacturer (placeholder)
    "1";                      -- required by IEEE 1149.1

  attribute REGISTER_ACCESS of chip : entity is
    "DEVICE_ID (IDCODE)";

  attribute DESIGN_WARNING of chip : entity is
      "Generated by warptap. TAP-only description, NOT a chip-level BSDL: " &
      "no BOUNDARY_LENGTH or BOUNDARY_REGISTER is declared, so a tool that " &
      "requires a boundary register will reject this file. EXTEST (0000) " &
      "and SAMPLE/PRELOAD (0010) do not select a boundary register: they " &
      "connect TDO to the IEEE 1687 IJTAG network (the SIB chain) " &
      "described by the companion ICL AccessLink. Its length depends on " &
      "SIB state, so it is not declared in REGISTER_ACCESS. Load EXTEST to " &
      "reach that network. Not fully IEEE 1149.1 conformant: TDO changes " &
      "on the rising edge of TCK and is driven low, not tri-stated, " &
      "outside the shift states, and the IDCODE value is a placeholder, " &
      "not a registered manufacturer ID. PHYSICAL_PIN_MAP UNPACKAGED is a " &
      "placeholder: no physical package is described.";

end chip;
