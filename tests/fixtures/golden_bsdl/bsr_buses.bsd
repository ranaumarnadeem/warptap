-- BSDL for the IEEE 1149.1 TAP and boundary-scan register inserted by warptap.
-- Read the DESIGN_WARNING attribute below before using this file with a boundary-scan tool.

entity bsr_buses is

  generic (PHYSICAL_PIN_MAP : string := "UNPACKAGED");

  port (
    tck     : in bit;
    tms     : in bit;
    tdi     : in bit;
    trst_n  : in bit;
    tdo     : out bit;
    clk     : in bit;
    rst_n   : in bit;
    a       : in bit;
    din     : in bit_vector(3 downto 0);
    lane    : in bit_vector(0 to 1);
    io_oe   : in bit;
    dbus_oe : in bit;
    dout    : out bit_vector(2 downto 0);
    flag    : out bit;
    io      : inout bit;
    dbus    : inout bit_vector(1 downto 0)
  );

  use STD_1149_1_2001.all;

  attribute COMPONENT_CONFORMANCE of bsr_buses : entity is "STD_1149_1_2001";

  attribute PIN_MAP of bsr_buses : entity is PHYSICAL_PIN_MAP;

  constant UNPACKAGED : PIN_MAP_STRING :=
    "tck     : tck," &
    "tms     : tms," &
    "tdi     : tdi," &
    "trst_n  : trst_n," &
    "tdo     : tdo," &
    "clk     : clk," &
    "rst_n   : rst_n," &
    "a       : a," &
    "din     : (din_3, din_2, din_1, din_0)," &
    "lane    : (lane_0, lane_1)," &
    "io_oe   : io_oe," &
    "dbus_oe : dbus_oe," &
    "dout    : (dout_2, dout_1, dout_0)," &
    "flag    : flag," &
    "io      : io," &
    "dbus    : (dbus_1, dbus_0)";

  attribute TAP_SCAN_IN    of tdi     : signal is true;
  attribute TAP_SCAN_MODE  of tms     : signal is true;
  attribute TAP_SCAN_OUT   of tdo     : signal is true;
  attribute TAP_SCAN_CLOCK of tck     : signal is (1.000000e+07, BOTH);
  attribute TAP_SCAN_RESET of trst_n  : signal is true;

  attribute INSTRUCTION_LENGTH of bsr_buses : entity is 4;

  attribute INSTRUCTION_OPCODE of bsr_buses : entity is
    "EXTEST  (0000)," &
    "SAMPLE  (0010)," &
    "PRELOAD (0010)," &
    "IDCODE  (0001)," &
    "BYPASS  (1111)";

  attribute INSTRUCTION_CAPTURE of bsr_buses : entity is "0001";

  attribute IDCODE_REGISTER of bsr_buses : entity is
    "0001" &                  -- version
    "0010001101000101" &      -- part number
    "01100111100" &           -- manufacturer
    "1";                      -- required by IEEE 1149.1

  attribute REGISTER_ACCESS of bsr_buses : entity is
    "BOUNDARY (EXTEST, SAMPLE, PRELOAD)," &
    "DEVICE_ID (IDCODE)";

  attribute BOUNDARY_LENGTH of bsr_buses : entity is 23;

  attribute BOUNDARY_REGISTER of bsr_buses : entity is
    "0 (BC_7, dbus(1), bidir, X, 1, 0, Z)," &
    "1 (BC_1, *, control, 0)," &
    "2 (BC_7, dbus(0), bidir, X, 3, 0, Z)," &
    "3 (BC_1, *, control, 0)," &
    "4 (BC_7, io, bidir, X, 5, 0, Z)," &
    "5 (BC_1, *, control, 0)," &
    "6 (BC_1, flag, output3, X, 7, 0, Z)," &
    "7 (BC_1, *, control, 0)," &
    "8 (BC_1, dout(2), output3, X, 9, 0, Z)," &
    "9 (BC_1, *, control, 0)," &
    "10 (BC_1, dout(1), output3, X, 11, 0, Z)," &
    "11 (BC_1, *, control, 0)," &
    "12 (BC_1, dout(0), output3, X, 13, 0, Z)," &
    "13 (BC_1, *, control, 0)," &
    "14 (BC_1, dbus_oe, input, X)," &
    "15 (BC_1, io_oe, input, X)," &
    "16 (BC_1, lane(0), input, X)," &
    "17 (BC_1, lane(1), input, X)," &
    "18 (BC_1, din(3), input, X)," &
    "19 (BC_1, din(2), input, X)," &
    "20 (BC_1, din(1), input, X)," &
    "21 (BC_1, din(0), input, X)," &
    "22 (BC_1, a, input, X)";

  attribute DESIGN_WARNING of bsr_buses : entity is
      "Generated by warptap. These ports have no boundary-register cell, " &
      "so boundary scan neither observes nor controls them: clk, rst_n. " &
      "The instruction register and every update stage latch on the rising " &
      "edge of TCK that leaves Update-IR or Update-DR, half a TCK period " &
      "after IEEE 1149.1's falling edge in those states: a tester that " &
      "stops TCK in Update-IR or Update-DR sees the new instruction or " &
      "outputs only at the next rising edge. PHYSICAL_PIN_MAP UNPACKAGED " &
      "is a placeholder: no physical package is described, and each pin is " &
      "named after its port.";

end bsr_buses;
