    family-names: Nadeem
    email: rana.umar.nadeem21@gmail.com
    orcid: "https://orcid.org/0009-0008-9880-0116"
version: 0.0.3
license: Apache-2.0
repository-code: "https://github.com/ranaumarnadeem/warptap"
url: "https://ranaumarnadeem.github.io/warptap/"
keywords:
  - JTAG
  - IJTAG
  - IEEE 1149.1
  - IEEE 1687
  - ICL
  - PDL
  - boundary scan
  - design for test
  - DFT
  - SVF
